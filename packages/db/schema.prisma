// ─── Generator & Datasource ────────────────────────────────────────────────

generator client {
  provider        = "prisma-client-js"
  output          = "../../node_modules/.prisma/client"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ─────────────────────────────────────────────────────────────────

enum UserRole {
  STUDENT
  COORDINATOR
  ADMIN
}

enum CompanyStatus {
  UPCOMING
  OPEN
  CLOSED
}

enum ApplicationStage {
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
}

enum OAResult {
  PASS
  FAIL
  PENDING
}

enum RoundType {
  TECHNICAL
  HR
  MANAGERIAL
  GROUP_DISCUSSION
}

enum RoundResult {
  PASS
  FAIL
  PENDING
}

enum NotificationType {
  DEADLINE
  ANNOUNCEMENT
  STAGE_UPDATE
}

enum ResourceType {
  OA_PREP
  INTERVIEW_PREP
  RESUME
  OTHER
}

// ─── User ──────────────────────────────────────────────────────────────────

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  hashedPassword String   @map("hashed_password")
  role           UserRole @default(STUDENT)

  // Academic profile
  branch         String
  cgpa           Float
  backlogs       Int    @default(0)
  graduationYear Int    @map("graduation_year")

  // Optional
  avatarUrl  String? @map("avatar_url")
  rollNumber String? @unique @map("roll_number")
  phone      String?

  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  accounts Account[]
  sessions Session[]

  applications      Application[]
  discussionPosts   DiscussionPost[]
  notifications     Notification[]
  createdCompanies  Company[]        @relation("CompanyCreator")
  uploadedResources Resource[]
  announcements     Announcement[]

  @@index([email])
  @@index([role])
  @@index([branch, graduationYear])
  @@map("users")
}

// ─── Company ───────────────────────────────────────────────────────────────

model Company {
  id      String  @id @default(cuid())
  name    String
  logoUrl String? @map("logo_url")
  website String?
  sector  String?

  // Role & compensation
  role       String
  packageLpa Float  @map("package_lpa")
  packageMax Float? @map("package_max") // for range (e.g. 12–18 LPA)
  jobType    String @default("Full-time") // Full-time, Intern+PPO, etc.

  // Eligibility criteria (stored as structured columns for indexed querying)
  minCgpa     Float    @default(0) @map("min_cgpa")
  maxBacklogs Int      @default(0) @map("max_backlogs")
  branches    String[] // e.g. ["CSE", "ECE"]

  // Documents
  jdUrl       String? @map("jd_url")
  description String?

  // Lifecycle
  deadline  DateTime
  driveDate DateTime?     @map("drive_date")
  status    CompanyStatus @default(UPCOMING)

  // Audit
  createdById String   @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  createdBy     User             @relation("CompanyCreator", fields: [createdById], references: [id])
  applications  Application[]
  discussions   DiscussionPost[]
  resources     Resource[]
  announcements Announcement[]

  @@index([status])
  @@index([deadline])
  @@index([minCgpa])
  @@index([status, deadline])
  @@map("companies")
}

// ─── Application ───────────────────────────────────────────────────────────

model Application {
  id        String           @id @default(cuid())
  studentId String           @map("student_id")
  companyId String           @map("company_id")
  stage     ApplicationStage @default(APPLIED)

  // Optional student notes
  notes String?

  // Timestamps
  appliedAt DateTime @default(now()) @map("applied_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  student         User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  oaRecords       OARecord[]
  interviewRounds InterviewRound[]

  // A student can only apply once per company
  @@unique([studentId, companyId])
  @@index([studentId])
  @@index([companyId])
  @@index([stage])
  @@index([studentId, stage])
  @@map("applications")
}

// ─── OA Record ─────────────────────────────────────────────────────────────

model OARecord {
  id            String @id @default(cuid())
  applicationId String @map("application_id")

  platform     String // HackerRank, HackerEarth, etc.
  testDate     DateTime @map("test_date")
  durationMins Int?     @map("duration_mins")

  // Score can be percentage, raw score, or null if not disclosed
  score      Float?
  totalScore Float?   @map("total_score")
  result     OAResult @default(PENDING)

  // Optional feedback / notes
  notes String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([result])
  @@map("oa_records")
}

// ─── Interview Round ────────────────────────────────────────────────────────

model InterviewRound {
  id            String @id @default(cuid())
  applicationId String @map("application_id")

  roundNumber  Int       @map("round_number")
  type         RoundType
  date         DateTime
  durationMins Int?      @map("duration_mins")
  mode         String? // "Online" | "In-person" | "Telephonic"

  feedback String?
  result   RoundResult @default(PENDING)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  // Round numbers must be unique per application
  @@unique([applicationId, roundNumber])
  @@index([applicationId])
  @@index([result])
  @@map("interview_rounds")
}

// ─── Discussion Post ────────────────────────────────────────────────────────

model DiscussionPost {
  id        String  @id @default(cuid())
  companyId String  @map("company_id")
  authorId  String  @map("author_id")
  content   String
  parentId  String? @map("parent_id") // null = top-level post; set = reply

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  DiscussionPost?  @relation("Replies", fields: [parentId], references: [id])
  replies DiscussionPost[] @relation("Replies")

  @@index([companyId])
  @@index([authorId])
  @@index([parentId])
  @@index([companyId, createdAt])
  @@map("discussion_posts")
}

// ─── Notification ───────────────────────────────────────────────────────────

model Notification {
  id      String           @id @default(cuid())
  userId  String           @map("user_id")
  type    NotificationType
  message String
  read    Boolean          @default(false)

  // Optional metadata for deep-linking
  companyId     String? @map("company_id")
  applicationId String? @map("application_id")

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ─── Resource ───────────────────────────────────────────────────────────────

model Resource {
  id           String @id @default(cuid())
  companyId    String @map("company_id")
  uploadedById String @map("uploaded_by_id")

  title       String
  url         String
  type        ResourceType
  description String?

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id])

  @@index([companyId])
  @@index([type])
  @@map("resources")
}

// ─── Announcement ──────────────────────────────────────────────────────────

model Announcement {
  id        String  @id @default(cuid())
  title     String
  body      String
  companyId String? @map("company_id") // null = platform-wide
  authorId  String  @map("author_id")

  // Target audience filter
  targetBranches String[] @map("target_branches") // empty = all branches
  targetGradYear Int?     @map("target_grad_year") // null = all years

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  company Company? @relation(fields: [companyId], references: [id])
  author  User     @relation(fields: [authorId], references: [id])

  @@index([companyId])
  @@index([createdAt])
  @@map("announcements")
}

// ─── NextAuth required tables ──────────────────────────────────────────────
// These are needed by @auth/prisma-adapter

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
