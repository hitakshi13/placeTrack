    "test:coverage": "vitest run --coverage",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "npm run test && npm run test:e2e"
  },
  "prisma": {
    "schema": "packages/db/schema.prisma",
    "seed": "tsx packages/db/seed.ts"
  },
  "dependencies": {
